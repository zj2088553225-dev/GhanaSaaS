# Customer authentication and password reset are independent. Password reset
# must remain false until a real email delivery provider is implemented.
STOREFRONT_AUTH_ENABLED=false
VITE_STOREFRONT_AUTH_ENABLED=false
CUSTOMER_PASSWORD_RESET_ENABLED=false
VITE_CUSTOMER_PASSWORD_RESET_ENABLED=false
# Unified trusted peers for authentication, analytics, and reservations.
# RESERVATION_TRUSTED_PROXY_CIDRS remains a temporary fallback only.
TRUSTED_PROXY_CIDRS=
PRODUCT_POPULARITY_CACHE_TTL_SECONDS=120

# Reservation modes: disabled, anonymous, or otp. Keep API and Web identical.
RESERVATION_MODE=disabled
VITE_RESERVATION_MODE=disabled
RESERVATION_BROWSER_HASH_SECRET=
RESERVATION_IP_HASH_SECRET=
RESERVATION_TRUSTED_PROXY_CIDRS=
RESERVATION_ANONYMOUS_TTL_HOURS=24
RESERVATION_BROWSER_LIMIT_PER_HOUR=5
RESERVATION_BROWSER_LIMIT_PER_DAY=20
RESERVATION_IP_LIMIT_PER_HOUR=20
RESERVATION_IP_LIMIT_PER_DAY=100
RESERVATION_IP_PRODUCT_LIMIT_PER_DAY=3
# Set both Turnstile switches to true in anonymous/otp mode. Anonymous uses
# reservation_create; OTP uses reservation_otp.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=reservation_otp
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
