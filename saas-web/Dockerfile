FROM node:22.23.1-alpine3.23 AS builder

ARG VITE_API_BASE_URL=/api/v1
ARG VITE_STOREFRONT_AUTH_ENABLED=false
ARG VITE_CUSTOMER_PASSWORD_RESET_ENABLED=false
ARG VITE_STOREFRONT_PRICE_VISIBLE=false
ARG VITE_ADMIN_BASE_PATH=/gc-control-7x
ARG VITE_MERCHANT_WHATSAPP_URL=
ARG VITE_RESERVATION_MODE=disabled
ARG VITE_TURNSTILE_ENABLED=false
ARG VITE_TURNSTILE_SITE_KEY=
ARG VITE_GOOGLE_MAPS_EMBED_KEY=

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_STOREFRONT_AUTH_ENABLED=$VITE_STOREFRONT_AUTH_ENABLED \
    VITE_CUSTOMER_PASSWORD_RESET_ENABLED=$VITE_CUSTOMER_PASSWORD_RESET_ENABLED \
    VITE_STOREFRONT_PRICE_VISIBLE=$VITE_STOREFRONT_PRICE_VISIBLE \
    VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH \
    VITE_MERCHANT_WHATSAPP_URL=$VITE_MERCHANT_WHATSAPP_URL \
    VITE_RESERVATION_MODE=$VITE_RESERVATION_MODE \
    VITE_TURNSTILE_ENABLED=$VITE_TURNSTILE_ENABLED \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY \
    VITE_GOOGLE_MAPS_EMBED_KEY=$VITE_GOOGLE_MAPS_EMBED_KEY

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.28.3-alpine3.23 AS runner

COPY --from=builder /app/dist/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
