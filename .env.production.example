APP_ENV=production
APP_PORT=8080
SERVER_PORT=8080

DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_TIMEZONE=UTC
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

JWT_SECRET=
JWT_EXPIRE_DURATION=24h
OPENAPI_LEGACY_SIGNATURE_ENABLED=false

# Required only when cmd/seeder creates the first administrator accounts.
INITIAL_SUPER_ADMIN_PHONE=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_TENANT_ADMIN_PHONE=
INITIAL_TENANT_ADMIN_PASSWORD=

# Required only when running cmd/reset_admin.
RESET_ADMIN_PHONE=
RESET_ADMIN_PASSWORD=

STOREFRONT_AUTH_ENABLED=false
# Keep both reset flags false: this release has no email delivery provider.
CUSTOMER_PASSWORD_RESET_ENABLED=false
STOREFRONT_PRICE_VISIBLE=false
PLATFORM_MALL_TENANT_ID=1
PRODUCT_POPULARITY_CACHE_TTL_SECONDS=120

# Unified direct/transitive trusted proxy chain for auth, analytics, and
# reservations. Include only controlled proxy/Cloudflare CIDRs; never /0.
TRUSTED_PROXY_CIDRS=

# Production anonymous reservation mode. Keep the API and Web values identical.
RESERVATION_MODE=anonymous

# Anonymous mode requires only the browser/IP hash secrets below. Contact
# secrets are OTP-only and may remain empty in anonymous mode.
RESERVATION_CONTACT_HASH_SECRET=
RESERVATION_CONTACT_ENCRYPTION_KEY=
RESERVATION_BROWSER_HASH_SECRET=
RESERVATION_IP_HASH_SECRET=
# Comma-separated CIDRs for only the reverse proxies that can directly or
# transitively append X-Forwarded-For. Never use 0.0.0.0/0 or ::/0.
# Legacy fallback for one release. Leave empty when TRUSTED_PROXY_CIDRS is set.
RESERVATION_TRUSTED_PROXY_CIDRS=
RESERVATION_ANONYMOUS_TTL_HOURS=24
RESERVATION_BROWSER_LIMIT_PER_HOUR=5
RESERVATION_BROWSER_LIMIT_PER_DAY=20
RESERVATION_IP_LIMIT_PER_HOUR=20
RESERVATION_IP_LIMIT_PER_DAY=100
RESERVATION_IP_PRODUCT_LIMIT_PER_DAY=3
RESERVATION_HEAT_POPULAR_MIN=5
RESERVATION_HEAT_TRENDING_MIN=20
RESERVATION_HEAT_HIGHLY_REQUESTED_MIN=50
RESERVATION_ATTEMPT_RETENTION_DAYS=30

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=reservation_create
TURNSTILE_VERIFY_TIMEOUT_SECONDS=5

# OTP-only settings. They are not required or initialized in anonymous mode.
OTP_PROVIDER=
RESERVATION_OTP_CHANNELS=
OTP_PROVIDER_TIMEOUT_SECONDS=5
RESERVATION_OTP_RESPONSE_MIN_MILLISECONDS=750
RESERVATION_OTP_CHALLENGE_TTL_MINUTES=10
RESERVATION_OTP_RESEND_COOLDOWN_SECONDS=60
RESERVATION_OTP_MAX_VERIFY_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

RESERVATION_INTEREST_VISITOR_PER_MINUTE=20
RESERVATION_INTEREST_IP_PER_MINUTE=60
RESERVATION_INTEREST_GLOBAL_PER_MINUTE=1000
RESERVATION_OTP_CONTACT_PER_30_MIN=3
RESERVATION_OTP_CONTACT_PER_DAY=5
RESERVATION_OTP_VISITOR_PER_HOUR=5
RESERVATION_OTP_IP_PER_HOUR=20
RESERVATION_OTP_GLOBAL_PER_MINUTE=100
RESERVATION_VERIFY_VISITOR_PER_10_MIN=15
RESERVATION_VERIFY_IP_PER_10_MIN=50
RESERVATION_VERIFY_GLOBAL_PER_MINUTE=500
RESERVATION_CANCEL_IP_PER_MINUTE=60
RESERVATION_CANCEL_GLOBAL_PER_MINUTE=1000

VITE_STOREFRONT_AUTH_ENABLED=false
VITE_CUSTOMER_PASSWORD_RESET_ENABLED=false
VITE_STOREFRONT_PRICE_VISIBLE=false
VITE_ADMIN_BASE_PATH=/gc-control-7x
VITE_API_BASE_URL=/api/v1
VITE_MERCHANT_WHATSAPP_URL=
VITE_RESERVATION_MODE=anonymous
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_MAPS_EMBED_KEY=

# Optional local image repository names. deploy.sh appends the target commit tag.
API_IMAGE_REPOSITORY=saas-api
WEB_IMAGE_REPOSITORY=saas-web
