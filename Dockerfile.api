FROM golang:1.26.2-alpine AS builder

WORKDIR /app
ENV GOCACHE=/go-cache

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/go-cache \
    CGO_ENABLED=0 GOOS=linux go build -o api ./cmd/api && \
    CGO_ENABLED=0 GOOS=linux go build -o holiday-import ./cmd/holiday-import && \
    CGO_ENABLED=0 GOOS=linux go build -o platform-category-search-rebuild ./cmd/platform-category-search-rebuild

FROM alpine:3.23.5 AS runner

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
RUN addgroup -S app && adduser -S app -G app && \
    mkdir -p uploads/images uploads/videos configs && \
    chown -R app:app /app && \
    chmod -R 755 uploads

COPY --from=builder /app/api ./api
COPY --from=builder /app/holiday-import ./holiday-import
COPY --from=builder /app/platform-category-search-rebuild ./platform-category-search-rebuild
COPY --from=builder /app/deploy/holiday-data/us-2026.example.json ./holiday-data/us-2026.example.json

USER app
EXPOSE 8080
CMD ["./api"]
